---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts } from '../../data/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = formatDate(post.data.date);
---

<Base title={post.data.title} description={post.data.description} ogType="article">
  <article>
    <header class="post-header">
      <p class="post-kicker">
        <time datetime={date.iso}>{date.full}</time>
        {post.data.tags.length > 0 && ' · '}
        {post.data.tags.map((tag, index) => (
          <>
            <a href={`/tags/${tag}/`}>{tag}</a>
            {index < post.data.tags.length - 1 && '、'}
          </>
        ))}
      </p>
      <h1 class="post-title">{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
