---
import { site } from '../data/site';

const path = Astro.url.pathname;
const items = [
  { href: '/', label: '文章', show: true },
  { href: '/archive/', label: '归档', show: true },
  { href: '/about/', label: '关于', show: site.showAbout },
  { href: '/resume/', label: '简历', show: site.showResume },
].filter((item) => item.show);

function current(href: string) {
  if (href === '/') return path === '/' ? 'page' : undefined;
  return path === href || path.startsWith(href) ? 'page' : undefined;
}
---

<header class="site-header">
  <a class="brand" href="/">
    <span class="brand-mark">P</span>
    <span class="brand-name">Pinocchio</span>
  </a>
  <nav class="nav" aria-label="站内">
    {items.map((item) => (
      <a href={item.href} aria-current={current(item.href)}>{item.label}</a>
    ))}
    <button
      id="theme-toggle"
      class="theme-toggle"
      type="button"
      aria-label="切换浅色或深色外观"
      aria-pressed="false"
    >
      <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z" stroke-linejoin="round"></path>
      </svg>
      <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 3v1.5M12 19.5V21M4.9 4.9l1.1 1.1M18 18l1.1 1.1M3 12h1.5M19.5 12H21M4.9 19.1 6 18M18 6l1.1-1.1" stroke-linecap="round"></path>
      </svg>
    </button>
  </nav>
</header>
